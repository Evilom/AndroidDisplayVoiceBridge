{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Android Display Voice Bridge configuration",
  "type": "object",
  "required": ["adbPath", "behavior", "devices"],
  "properties": {
    "$schema": { "type": "string" },
    "adbPath": { "type": "string", "minLength": 1 },
    "logDirectory": { "type": "string", "minLength": 1 },
    "behavior": {
      "type": "object",
      "required": [
        "showNotifications",
        "logRecognizedText",
        "armTimeoutSeconds",
        "finalTimeoutSeconds",
        "reconnectDelayMilliseconds",
        "duplicateSuppressionMilliseconds"
      ],
      "properties": {
        "showNotifications": { "type": "boolean" },
        "logRecognizedText": { "type": "boolean" },
        "armTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "finalTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "reconnectDelayMilliseconds": { "type": "integer", "minimum": 500, "maximum": 60000 },
        "duplicateSuppressionMilliseconds": { "type": "integer", "minimum": 0, "maximum": 30000 }
      },
      "additionalProperties": false
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "enabled",
          "serial",
          "inputDevice",
          "keyToken",
          "logcatFilter",
          "finalAsrPattern"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "enabled": { "type": "boolean" },
          "serial": { "type": "string", "minLength": 1 },
          "autoConnect": { "type": "boolean" },
          "keepAndroidAwakeWhilePowered": { "type": "boolean" },
          "inputDevice": { "type": "string", "pattern": "^/dev/input/event[0-9]+$" },
          "keyToken": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "logcatFilter": { "type": "string", "minLength": 1 },
          "finalAsrPattern": { "type": "string", "minLength": 1 },
          "voicePackage": { "type": "string" },
          "manageVoicePackage": { "type": "boolean" },
          "disableVoicePackageWhenInactive": { "type": "boolean" },
          "stopAssistantAfterFinal": { "type": "boolean" },
          "startServiceFallback": { "type": "boolean" },
          "serviceComponent": { "type": "string" },
          "keyDownAction": { "type": "string" },
          "keyUpAction": { "type": "string" },
          "remoteType": { "type": "integer", "minimum": 0, "maximum": 1000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
